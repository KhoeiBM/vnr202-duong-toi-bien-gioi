rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hồ sơ + thành tích quiz: mỗi user chỉ đọc/ghi được dữ liệu của chính mình.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /quiz_results/{docId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false; // thành tích đã ghi thì không sửa — chỉ tạo mới hoặc xóa
      }
    }
  }
}
